# Copia este archivo como .env y rellena tu clave de la API de Claude
# (consíguela en https://platform.claude.com, apartado API Keys).
ANTHROPIC_API_KEY=

# Modelo que usan los agentes.
MODELO=claude-opus-5-5

# Límite de turnos de trabajo al día (controla el gasto).
MAX_TURNOS_DIA=150

# Cuántos agentes trabajan a la vez.
AGENTES_EN_PARALELO=2

# Cada cuántos segundos se revisa si hay trabajo nuevo.
INTERVALO_SEGUNDOS=10

# Minutos tras los que un agente retoma una tarea que dejó a medias.
RETOMAR_TAREAS_MINUTOS=30

# Búsqueda web para investigar empresas, normativa y SEO (on/off).
BUSQUEDA_WEB=on

# Puerto de la oficina en tu ordenador.
PUERTO=3000
